<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ c.name }} Tools — {{ site.name }}</title>
<meta name="description" content="Free online {{ c.name | lower }} tools. {{ c.description }}"/>
<link rel="canonical" href="{{ site.domain }}/category/{{ c.slug }}/"/>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%232563eb'/%3E%3Ctext x='50' y='70' font-size='58' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'%3EQ%3C/text%3E%3C/svg%3E"/>
<style>
:root{--bg:#f5f7fa;--card:#ffffff;--text:#1f2937;--muted:#6b7280;--accent:#2563eb;--border:#e5e7eb;--radius:12px;--maxw:980px}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;line-height:1.65;font-size:16px}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
.container{max-width:var(--maxw);margin:0 auto;padding:0 16px}
header.site-header{background:var(--card);border-bottom:1px solid var(--border)}
.site-inner{display:flex;align-items:center;justify-content:space-between;min-height:58px}
.logo{font-weight:800;font-size:19px;color:#111827}
.ad-zone{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 8px;overflow:hidden}
.ad-label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#9ca3af}
@media (max-width:767px){.hide-mobile{display:none!important}}
@media (min-width:768px){.hide-desktop{display:none!important}}
.breadcrumb{font-size:13px;color:var(--muted);margin:16px 0 2px}
.breadcrumb .sep{margin:0 6px;color:#d1d5db}
h1{font-size:clamp(22px,4.5vw,30px);margin:8px 0 8px;color:#111827}
.cat-desc{color:var(--muted);margin:0 0 18px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;margin-bottom:10px}
.tile{display:block;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;color:var(--text)}
.tile:hover{box-shadow:0 6px 16px rgba(16,24,40,.08);text-decoration:none}
.tile h3{margin:8px 0 4px;font-size:16.5px;color:#111827}
.tile p{margin:0;font-size:13.8px;color:var(--muted)}
.badge{display:inline-block;background:#eff6ff;color:#1d4ed8;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;border-radius:999px;padding:2px 9px}
.empty{background:var(--card);border:1px dashed var(--border);border-radius:var(--radius);padding:26px;text-align:center;color:var(--muted)}
.back{margin-top:18px}
footer.site-footer{margin-top:40px;background:var(--card);border-top:1px solid var(--border)}
.footer-inner{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;padding:18px 0;color:var(--muted);font-size:13.5px}
</style>
</head>
<body>
<header class="site-header">
  <div class="container site-inner">
    <a class="logo" href="{{ site.domain }}/{{ site.base_path }}">{{ site.name }}</a>
    <nav class="top-nav"><a href="{{ site.domain }}/{{ site.base_path }}">All Tools</a></nav>
  </div>
</header>

<div class="ad-zone">
  <div class="ad-label">Advertisement</div>
  <div class="hide-desktop">{{ ad_top_desktop | safe }}</div>
  <div class="hide-mobile">{{ ad_top_mobile | safe }}</div>
</div>

<main class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ site.domain }}/{{ site.base_path }}">Home</a><span class="sep">/</span><span aria-current="page">{{ c.name }}</span>
  </nav>
  <h1>{{ c.name }} Tools</h1>
  <p class="cat-desc">{{ c.description }}</p>

  {% if c.tools %}
  <div class="grid">
    {% for t in c.tools %}
    <a class="tile" href="{{ t.url }}">
      <span class="badge">{{ c.name }}</span>
      <h3>{{ t.title }}</h3>
      <p>{{ t.description }}</p>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty">No tools in this category yet — new tools are added automatically every day. Check back soon.</div>
  {% endif %}

  <p class="back"><a href="{{ site.domain }}/{{ site.base_path }}">&larr; Browse all tools</a></p>

  <div class="ad-zone hide-mobile">
    <div class="ad-label">Advertisement</div>
    {{ ad_footer | safe }}
  </div>
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <div>&copy; {{ year }} {{ site.name }}. All tools run entirely in your browser.</div>
    <div class="footer-links">
      <a href="{{ site.domain }}/{{ site.base_path }}">Home</a>
      <a href="{{ site.domain }}/sitemap.xml">Sitemap</a>
    </div>
  </div>
</footer>
{{ analytics | safe }}
</body>
</html>
